{
  // Deployed by .github/workflows/deploy.yml on pushes to main that touch
  // edge/ (CLOUDFLARE_API_TOKEN repo secret).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jolt-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "account_id": "2cd5db709b9369660ed7f1d52527c933",
  "workers_dev": true,
  // Public edge hostname plus the clean install hostname. Both custom domains
  // terminate at this worker, which serves the installer and release artifacts.
  "routes": [
    {
      "pattern": "edge.jolt.trmcnvn.dev",
      "custom_domain": true
    },
    {
      "pattern": "jolt.trmcnvn.dev",
      "custom_domain": true
    }
  ],
  // Serve src/install.sh as a string (the /install.sh route).
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.sh"
      ],
      "fallthrough": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSION_HUBS",
        "class_name": "SessionHub"
      },
      {
        "name": "DEVICE_ROOMS",
        "class_name": "DeviceRoom"
      },
      {
        "name": "REGISTRY_ROOMS",
        "class_name": "RegistryRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "SessionRoom",
        "DeviceRoom"
      ]
    },
    {
      // Workspace registry (docs/sync.md) — row-table sidebar sync.
      "tag": "v2",
      "new_sqlite_classes": [
        "RegistryRoom"
      ]
    },
    {
      // Typed commands plus host-published transcript projections.
      "tag": "v3",
      "new_sqlite_classes": [
        "SessionHub"
      ]
    },
    {
      "tag": "v4",
      "deleted_classes": [
        "SessionRoom"
      ]
    }
  ],
  "r2_buckets": [
    {
      "binding": "BLOBS",
      "bucket_name": "jolt-blobs"
    },
    {
      // Release artifacts for /releases/* (curl-install + dmg downloads).
      "binding": "RELEASES",
      "bucket_name": "jolt-releases"
    }
  ],
  "vars": {
    // WorkOS AuthKit client id — JWTs verified against its JWKS. Placeholder;
    // set the real client id before deploying. Set AUTH_MODE=dev locally to
    // accept bearer==userId. WORKOS_API_KEY is a wrangler secret
    // (`wrangler secret put WORKOS_API_KEY`) powering the /auth/* routes.
    "WORKOS_CLIENT_ID": "client_01KZ8TAWMB4TZHF5RSTJPGR84J",
    "AUTH_MODE": "workos"
  },
  "observability": {
    "enabled": true
  }
}
